# Copy to session.env, adjust to your running ACME instances, then source session.env.
export QF_MN_URL=http://127.0.0.1:8081
export QF_MN_BASE=quietfix-mn
export QF_IN_URL=http://127.0.0.1:9090
export QF_IN_BASE=quietfix-in
export QF_ORIGIN=CAdmin
export QF_POLL_SECONDS=2
export QF_HTTP_TIMEOUT=15
# One gateway AE can handle any number of machines. Use a distinct ID per gateway.
export QF_COLLECTOR_ID=collector-01
# Set to an address reachable FROM the MN-CSE container; replace VM_IP.
# Empty URLs keep compatibility polling (2s by default).
# export QF_ANALYZER_NOTIFY_URL=http://VM_IP:8091/notify
# export QF_FORWARDER_NOTIFY_URL=http://VM_IP:8092/notify
export QF_NOTIFY_HOST=0.0.0.0
export QF_ANALYZER_NOTIFY_PORT=8091
export QF_FORWARDER_NOTIFY_PORT=8092
export QF_RECONCILE_SECONDS=30
# Adaptive per-machine collection (seconds); legacy --interval uses replay mode.
export QF_MEASURE_PERIOD=1
export QF_NORMAL_PERIOD=5
export QF_ABNORMAL_PERIOD=1
export QF_OUTBOX_LIMIT=10000

# Optional ACP mode. Leave 0 until provisioning and live checks are complete.
export QF_ACP_ENABLED=0
export QF_ADMIN_ORIGIN=CAdmin
# Defaults match AE registration requests. If CSE assigns different AE-IDs, use those.
# export QF_COLLECTOR_ORIGIN=Cqfcollector-01
# export QF_ANALYZER_ORIGIN=Cqfanalyzer
# export QF_FORWARDER_ORIGIN=Cqfforwarder
# export QF_DASHBOARD_ORIGIN=Cqfdashboard

# Install models/quietfix.fcp on BOTH CSEs and re-apply ACP before enabling.
export QF_FLEX_ENABLED=0

# Optional oneM2M MQTT binding on collector -> MN only. HTTP is unchanged elsewhere.
export QF_COLLECTOR_PROTOCOL=http
export QF_MQTT_URL=mqtt://127.0.0.1:1883
# Required for MQTT: actual MN CSE-ID (not its resourceName or IP).
# export QF_MQTT_CSE_ID=/id-mn
export QF_MQTT_TOPIC_PREFIX=
# For authenticated/TLS broker deployments; do not commit credentials.
# export QF_MQTT_USERNAME=quietfix-collector
# export QF_MQTT_PASSWORD=REPLACE_LOCALLY
# export QF_MQTT_CA_FILE=/path/to/broker-ca.pem
# Authenticated HTTPS: origin -> certificate/key JSON; only this process's identities.
# export QF_HTTP_CA_FILE=/private/ca.crt
# export QF_HTTP_IDENTITIES_FILE=/private/identities.json
# Optional MQTT mutual TLS (broker ACL maps certificate identity).
# export QF_MQTT_CERT_FILE=/private/collector.crt
# export QF_MQTT_KEY_FILE=/private/collector.key
# Authenticated notification receiver; configure CSE outbound client certificates too.
# export QF_NOTIFY_CERT_FILE=/private/notify.crt
# export QF_NOTIFY_KEY_FILE=/private/notify.key
# export QF_NOTIFY_CA_FILE=/private/ca.crt
# export QF_NOTIFY_PEERS=qf-cse
# Requires FlexContainer mode and CSE semanticDescriptor support; re-apply ACP.
export QF_SEMANTIC_ENABLED=0
# Optional single-host controlled CSE handover; initialize private JSON before use.
# export QF_ROUTE_FILE=/private/quietfix/route.json
# Optional dashboard-only section mapping; unmatched machines appear in 미배정.
# export QF_DASHBOARD_SECTIONS=/absolute/path/dashboard_sections.json


# Mcc target and source identities; these are CSE IDs, not CSEBase names.
export QF_IN_CSE_ID=/id-quietfix-in
export QF_MN_CSE_ID=/id-quietfix-mn


QF_ANALYSIS_STALE_SECONDS=60
